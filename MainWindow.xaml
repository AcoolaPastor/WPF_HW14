<Window x:Class="WPF_HW14.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_HW14"
        mc:Ignorable="d"
        Title="Каталог товаров" Height="550" Width="420" Background="#EFEFEF">

    <Window.Resources>
        <local:Converter x:Key="converter"/>
        <DataTemplate x:Key="ProductTemplate" DataType="{x:Type local:Product}">
            <Border x:Name="Card"
                    HorizontalAlignment="Stretch"
                    Margin="6"
                    Padding="10"
                    CornerRadius="8"
                    BorderThickness="2"
                    BorderBrush="Gray"
                    Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="{Binding Image}"
                           Width="60" Height="60"
                           Stretch="Uniform"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding Price, StringFormat={}{0:N0} руб}"
                                   FontSize="14"
                                   Foreground="#444"/>
                        <TextBlock x:Name="CategoryText"
                                   Text="{Binding Category, Converter={StaticResource converter}}"
                                   FontSize="12"
                                   FontStyle="Italic"
                                   Foreground="#777"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Category}" Value="Еда">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#3C8C3C"/>
                    <Setter TargetName="Card" Property="Background" Value="#EAF7EA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="БытоваяТехника">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#3C6C9C"/>
                    <Setter TargetName="Card" Property="Background" Value="#E8F0FA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="БытоваяХимия">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#8B4513"/>
                    <Setter TargetName="Card" Property="Background" Value="#F5F5DC"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ListBox x:Name="ProductsListBox"
                 ItemsSource="{Binding Products}"
                 ItemTemplate="{StaticResource ProductTemplate}"
                 HorizontalContentAlignment="Stretch"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    </Grid>
</Window>
